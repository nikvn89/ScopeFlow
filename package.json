{
  "name": "scopeflow-genlayer",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:ledger": "node tests/run-ledger.mjs",
    "test:frontend": "node --experimental-strip-types --test tests/transaction_execution.test.mjs",
    "verify:deployed": "node tests/verify-deployed-source.mjs",
    "verify:runtime-receipts": "node --experimental-strip-types tests/verify-runtime-receipts.mjs",
    "verify": "npm run test:ledger && npm run test:frontend && npm run build"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "2.55.13"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.4.3"
  }
}
